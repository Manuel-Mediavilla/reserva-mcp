{
  "name": "reserva-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor MCP de reservas de restaurante: herramientas tipadas para consultar disponibilidad y gestionar reservas, con logging de tool-calls y rate limiting",
  "scripts": {
    "build": "tsc",
    "start:stdio": "tsx src/server.ts",
    "start:http": "tsx src/httpServer.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "eval": "tsx eval/run-eval.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
